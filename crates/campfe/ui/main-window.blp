using Gtk 4.0;
using Adw 1;

template $CampfeWindow: Adw.ApplicationWindow {
  title: _("Campfe");
  default-width: 1400;
  default-height: 860;
  width-request: 360;
  height-request: 400;

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Stack main_stack {
      transition-type: crossfade;

      StackPage {
        name: "no-account";
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            Gtk.MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          content: Adw.StatusPage welcome_page {
            icon-name: "io.github.turbinebmw.Campfe-symbolic";
            title: _("Welcome to Campfe");
            description: _("Sign in to your Basecamp account to get started.");
            child: Gtk.Button sign_in_button {
              label: _("Sign in to Basecamp");
              halign: center;

              styles ["suggested-action", "pill"]
            };
          };
        };
      }

      StackPage {
        name: "signing-in";
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage {
            title: _("Waiting for Basecamp…");
            description: _("Finish signing in in your browser, then come back here.");
            child: Gtk.Box {
              orientation: vertical;
              spacing: 24;

              Adw.Spinner {
                width-request: 48;
                height-request: 48;
                halign: center;
              }

              Gtk.Button cancel_sign_in_button {
                label: _("Cancel");
                halign: center;

                styles ["pill"]
              }
            };
          };
        };
      }

      StackPage {
        name: "main";
        child: Adw.NavigationSplitView split {
          min-sidebar-width: 220;
          max-sidebar-width: 360;

          sidebar: Adw.NavigationPage {
            title: _("Projects");
            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle sidebar_title {
                  title: _("Basecamp");
                };

                [end]
                Gtk.MenuButton {
                  primary: true;
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Main Menu");
                  menu-model: primary_menu;
                }
              }

              content: Gtk.ScrolledWindow {
                hscrollbar-policy: never;

                child: Gtk.ListView sidebar_list {
                  styles ["navigation-sidebar"]
                };
              };
            };
          };

          content: Adw.NavigationPage content_page {
            title: _("Campfe");
            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                Gtk.Button {
                  icon-name: "view-refresh-symbolic";
                  tooltip-text: _("Refresh");
                  action-name: "win.refresh";
                }
              }

              content: Adw.StatusPage content_placeholder {
                icon-name: "io.github.turbinebmw.Campfe-symbolic";
                title: _("Pick a project");
              };
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Sign in to Basecamp");
      action: "win.sign-in";
    }
  }

  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Campfe");
      action: "app.about";
    }

    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
