using Gtk 4.0;
using Adw 1;

template $SkaliPreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");
  content-width: 560;

  Adw.PreferencesPage {
    Adw.PreferencesGroup accounts_group {
      title: _("Accounts");
      description: _("Every Basecamp account you are signed in to.");

      [header-suffix]
      Gtk.Button add_account_button {
        valign: center;
        tooltip-text: _("Sign in to another account");

        child: Adw.ButtonContent {
          icon-name: "list-add-symbolic";
          label: _("Add");
        };

        styles ["flat"]
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      Adw.SwitchRow follow_omarchy_row {
        title: _("Follow the Omarchy theme");
        subtitle: _("Take the current theme's colours and light or dark style. Elsewhere this does nothing.");
      }
    }

    Adw.PreferencesGroup {
      title: _("Notifications");

      Adw.SwitchRow notifications_row {
        title: _("Notify about new activity");
        subtitle: _("A desktop notification when Hey! has something new and the window isn't in front.");
      }
    }

    Adw.PreferencesGroup {
      title: _("AI summaries");
      description: _("A project's summary page has a coding agent you already use read its recent chats and message boards and write who's working on what. It runs signed in as you, only when you press Summarize, and what it reads goes to that agent's maker.");

      Adw.ComboRow summarizer_row {
        title: _("Summarize with");

        model: Gtk.StringList {
          strings [
            _("Off"),
            "Claude Code",
            "Codex",
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("GIFs");
      description: _("GIF search in chats uses KLIPY. Get a free API key at partner.klipy.com and paste it here.");

      Adw.PasswordEntryRow klipy_key_row {
        title: _("KLIPY API key");
      }
    }
  }
}
